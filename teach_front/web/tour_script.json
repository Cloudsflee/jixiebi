{
  "version": 1,
  "title": "机械臂教学引导",
  "steps": [
    {
      "id": "intro-stages",
      "phase": "intro",
      "stage": "control",
      "target": ".stage-nav",
      "placement": "right",
      "title": "三大教学阶段",
      "body": "本系统按「控制示教 → 正逆解实验 → 有限元演示」循序渐进。侧栏可随时切换阶段，本引导将带你完整体验。"
    },
    {
      "id": "intro-viewport",
      "phase": "intro",
      "stage": "control",
      "target": "#viewport",
      "placement": "left",
      "title": "三维数字孪生视口",
      "body": "中央 3D 视图实时反映关节姿态。注意 HUD 中的末端位置与当前模式说明。"
    },
    {
      "id": "control-joints",
      "phase": "control",
      "stage": "control",
      "target": "#jointControls",
      "placement": "top",
      "title": "关节拖动示教",
      "body": "拖动滑条可直观感受各关节运动。接下来将轻微调整 J2 以展示联动效果。",
      "action": "nudgeJ2",
      "actionDelay": 200
    },
    {
      "id": "control-demo-panel",
      "phase": "control",
      "stage": "control",
      "target": "#controlDemoPanel",
      "placement": "top",
      "title": "示教演示旁白",
      "body": "此处显示一键演示的步骤进度与解说文案。将先回到零位姿态便于对照。",
      "action": "applyControlZero",
      "actionDelay": 300
    },
    {
      "id": "control-one-click",
      "phase": "control",
      "stage": "control",
      "target": "#btnDemo",
      "placement": "right",
      "title": "一键教学演示",
      "body": "侧栏「一键教学演示」可自动播放关节示教脚本（零位→旋转轴→联动→微调）；演示中可再次点击停止。"
    },
    {
      "id": "control-axes",
      "phase": "control",
      "stage": "control",
      "target": "#toggleAxes",
      "placement": "top",
      "title": "旋转轴可视化",
      "body": "勾选「显示旋转轴线」可在模型上看到各关节旋转轴，便于建立空间直觉。"
    },
    {
      "id": "kin-stage",
      "phase": "kinematics",
      "stage": "kinematics",
      "target": "#btnStageKinematics",
      "placement": "right",
      "title": "进入正逆解实验",
      "body": "第二阶段学习运动学：给定末端目标点，求解关节角并验证精度。"
    },
    {
      "id": "kin-input",
      "phase": "kinematics",
      "stage": "kinematics",
      "target": ".kin-input-col",
      "placement": "bottom",
      "title": "目标点输入",
      "body": "在逆解模式下输入末端目标坐标。将载入 L3 课时目标点作为实验输入。",
      "action": "prepareKinL3",
      "actionDelay": 250
    },
    {
      "id": "kin-steps",
      "phase": "kinematics",
      "stage": "kinematics",
      "target": "#kinSteps",
      "placement": "bottom",
      "title": "四步求解流程",
      "body": "标准流程：输入 → 可达性 → 求解 → 验证。将依次高亮前三步。",
      "action": "kinFlowToSolve",
      "actionDelay": 400
    },
    {
      "id": "kin-solve",
      "phase": "kinematics",
      "stage": "kinematics",
      "target": "#btnSolveIK",
      "placement": "bottom",
      "title": "执行逆解",
      "body": "点击执行逆解将根据目标点生成关节角，机械臂将运动到对应姿态。",
      "action": "solveIk",
      "actionDelay": 500
    },
    {
      "id": "kin-candidates",
      "phase": "kinematics",
      "stage": "kinematics",
      "target": "#kinCandidateList",
      "placement": "top",
      "title": "肘上 / 肘下候选解",
      "body": "逆解可能存在多组解，可切换候选方案观察不同肘部构型。"
    },
    {
      "id": "kin-validate",
      "phase": "kinematics",
      "stage": "kinematics",
      "target": "#kinError",
      "placement": "top",
      "title": "验证末端误差",
      "body": "通过反向验证对比目标点与正运动学结果，理解求解精度。",
      "action": "reverseCheck",
      "actionDelay": 300
    },
    {
      "id": "kin-summary",
      "phase": "kinematics",
      "stage": "kinematics",
      "target": "#kinExplainText",
      "placement": "top",
      "title": "运动学小结",
      "body": "完成四步流后，您已掌握从目标点到关节角、再到误差验证的完整闭环。"
    },
    {
      "id": "fea-stage",
      "phase": "fea",
      "stage": "fea",
      "target": "#btnStageFea",
      "placement": "right",
      "title": "进入有限元演示",
      "body": "第三阶段在简化结构力学模型上，把「工况输入 → 云图 → 指标 → 趋势」串成完整观察链路。"
    },
    {
      "id": "fea-pose",
      "phase": "fea",
      "stage": "fea",
      "target": "#feaPoseSource",
      "placement": "top",
      "title": "姿态来源",
      "body": "可选择课时姿态或当前孪生姿态；机械臂在 01/02 中的关节角会同步到本阶段。",
      "action": "feaTourRatedSetup",
      "actionDelay": 400
    },
    {
      "id": "fea-scenario",
      "phase": "fea",
      "stage": "fea",
      "target": "#feaLoadScenarioRow",
      "placement": "top",
      "title": "载荷工况预设",
      "body": "轻载 / 额定 / 极限对应不同任务阶段，会联动载荷强度与末端质量。",
      "action": "feaTourLightScenario",
      "actionDelay": 350
    },
    {
      "id": "fea-direction",
      "phase": "fea",
      "stage": "fea",
      "target": "#feaLoadDirectionRow",
      "placement": "top",
      "title": "载荷方向",
      "body": "重力主导、侧向、组合受力会改变弯矩系数；将演示侧向载荷的影响。",
      "action": "feaTourShowDirectionSide",
      "actionDelay": 400
    },
    {
      "id": "fea-structure",
      "phase": "fea",
      "stage": "fea",
      "target": "#feaMaterialPreset",
      "placement": "top",
      "title": "材料与截面",
      "body": "材料屈服强度与臂段截面刚度进入简化模型；截面变细会放大应力，材料更软则安全系数下降。"
    },
    {
      "id": "fea-exaggeration",
      "phase": "fea",
      "stage": "fea",
      "target": "#feaExaggeration",
      "placement": "top",
      "title": "变形放大（仅云图）",
      "body": "该项只放大云图上的可见变形，不改变力学计算结果；将自动调高以作对比。",
      "action": "feaTourExaggerationDemo",
      "actionDelay": 350
    },
    {
      "id": "fea-stepper",
      "phase": "fea",
      "stage": "fea",
      "target": "#feaStepper",
      "placement": "bottom",
      "title": "有限元四步流",
      "body": "设置 → 计算 → 观察 → 解释。接下来进入「计算」步骤。",
      "action": "feaToCompute",
      "actionDelay": 300
    },
    {
      "id": "fea-run",
      "phase": "fea",
      "stage": "fea",
      "target": "#btnRunFea",
      "placement": "top",
      "title": "运行有限元演示",
      "body": "运行后云图着色与形变动画启动，右侧指标实时更新，并为趋势图积累采样点。",
      "action": "runFea",
      "actionDelay": 800
    },
    {
      "id": "fea-viewport",
      "phase": "fea",
      "stage": "fea",
      "target": "#viewport",
      "placement": "left",
      "title": "三维云图",
      "body": "颜色由应力水平映射：冷色偏低应力，暖色/红色为热点；与右侧最大应力指标一致。"
    },
    {
      "id": "fea-metrics",
      "phase": "fea",
      "stage": "fea",
      "target": ".fea-metrics",
      "placement": "left",
      "title": "核心风险指标",
      "body": "最大应力、位移、安全系数与风险等级与云图同步；安全系数低于 1.4 时需关注结构余量。"
    },
    {
      "id": "fea-hotspot",
      "phase": "fea",
      "stage": "fea",
      "target": "#btnFeaHotspot",
      "placement": "top",
      "title": "热点高亮",
      "body": "开启热点可在 J2/J3 等承载杆段突出高应力区，便于对照能耗占比讲解。"
    },
    {
      "id": "fea-chart-intro",
      "phase": "fea",
      "stage": "fea",
      "target": "#feaChart",
      "placement": "top",
      "title": "应力 / 位移趋势图",
      "body": "曲线记录仿真过程中的应力与位移采样；虚线为预警与危险阈值。",
      "action": "feaTourSeedChart",
      "actionDelay": 500
    },
    {
      "id": "fea-chart-compare",
      "phase": "fea",
      "stage": "fea",
      "target": "#feaChart",
      "placement": "top",
      "title": "载荷三档对比",
      "body": "将自动切换轻载 25% → 额定 55% → 极限 86%，观察趋势点上移与云图变热的原因。",
      "action": "feaTourLoadContrast",
      "actionDelay": 400
    },
    {
      "id": "fea-chart-try",
      "phase": "fea",
      "stage": "fea",
      "target": "#feaLoad",
      "placement": "top",
      "title": "手动调节载荷",
      "body": "请拖动「载荷强度」滑条：曲线、指标与云图应同步变化；下方灰字会说明变化原因。",
      "allowInteract": true,
      "interactTargets": ["#feaLoad"]
    },
    {
      "id": "fea-advanced",
      "phase": "fea",
      "stage": "fea",
      "target": "#feaAdvancedPanel",
      "placement": "top",
      "title": "区段贡献（高级）",
      "body": "展开后可查看 J2/J3/J4 应力与位移占比，理解大臂为何承担主要弯矩。",
      "action": "feaTourExpandAdvanced",
      "actionDelay": 200
    },
    {
      "id": "fea-explain",
      "phase": "fea",
      "stage": "fea",
      "target": "#feaExplainText",
      "placement": "top",
      "title": "有限元小结",
      "body": "工况输入决定载荷与刚度 → 云图与指标反映应力水平 → 趋势图展示随载荷变化的整体响应。"
    },
    {
      "id": "complete",
      "phase": "complete",
      "stage": "fea",
      "target": null,
      "placement": "center",
      "title": "引导完成",
      "body": "您已完成三大核心功能的完整体验。可随时点击侧栏「教学引导」重新开始。",
      "isComplete": true
    }
  ]
}
